# AiVee local env — NEVER commit. Copy structure lives in .env.example
# --- Claude (fill in yourself) ---
ANTHROPIC_API_KEY=
# --- Telegram (fill in yourself; chat id is discovered automatically) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: prepended to every Telegram message, e.g. [test]
TELEGRAM_PREFIX=
# Optional (API): the bot's @username for "Conectează Telegram" links; empty = resolved via getMe
TELEGRAM_BOT_USERNAME=
# Optional (ingest): false turns the link poller off on this instance (default true; one
# replica polls, chosen by a Postgres advisory lock)
TELEGRAM_POLL=
# --- Re-alert (ingest; names only) ---
# Seconds after "Merg eu" with nobody arrived before the whole location is alerted again
# (default 120).
REALERT_AFTER_S=
# --- Alert verification by a vision model (ingest; names only) ---
# true: ask the model once per opened alert whether the image(s) show the rule's situation
# before notifying (default false). Needs ANTHROPIC_API_KEY.
VERIFY_ALERTS=
# Model id (default claude-opus-5-5); seconds before the alert goes out unverified (default 20).
VERIFY_MODEL=
VERIFY_TIMEOUT_S=
# --- Postgres ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=
# --- Mosquitto (one user per role, ACL in infra/mosquitto/acl) ---
MQTT_API_USER=
MQTT_API_PASSWORD=
MQTT_INGEST_USER=
MQTT_INGEST_PASSWORD=
MQTT_EDGE_USER=
MQTT_EDGE_PASSWORD=
# Device that analyses uploaded clips; must start with `upload-` (default upload-01).
# `make keys` generates the password. Restart mosquitto after setting them.
MQTT_UPLOAD_USER=
MQTT_UPLOAD_PASSWORD=
# --- Web Push for the PWA (generated by `make vapid`; subject is a mailto: or https: contact) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# --- API / edge identity (names only; defaults SITE=demo, DEVICE=edge-01) ---
SITE=
DEVICE=
# --- Edge staff score (names only) ---
# CLIP cosine band mapped to appearance 0..1 (defaults 0.70 / 0.82).
APPEARANCE_LOW=
APPEARANCE_HIGH=
# Fusion weights, normalised over the available signals (defaults 0.60 / 0.25 / 0.15).
STAFF_W_APPEARANCE=
STAFF_W_STANDING=
STAFF_W_BEHAVIOUR=
# --- Snapshots (names only) ---
# Host API and ingest share one dir. Default SNAPSHOT_DIR=data/snapshots (relative to the
# repo root); compose bind-mounts ./data/snapshots into ingest and api at /data/snapshots.
SNAPSHOT_DIR=
# --- Video analysis (names only) ---
# Uploaded clips (default data/videos, created by `make data-dirs`). The API runs the edge
# on them with VIDEO_PYTHON (default: the API's own interpreter, which needs the edge
# installed: `make api` on the host, or the API image built with API_UV_EXTRAS="--extra ml").
VIDEO_DIR=
VIDEO_PYTHON=
# Host uid/gid the ingest container runs as, so it can write ./data/snapshots (default 1000).
AIVEE_UID=
AIVEE_GID=
# --- Compose API image (names only) ---
# Empty = slim image without enrolment models; "--extra ml" = with them (CPU torch).
API_UV_EXTRAS=
# --- Accounts (names only) ---
# Demo users' password for `make seed` (generated into .env when empty).
DEMO_PASSWORD=
# Dashboard origins allowed with credentials, comma-separated
# (default http://localhost:5173,http://localhost:5174).
CORS_ORIGINS=
# true behind HTTPS: the session cookie gets `Secure`.
COOKIE_SECURE=
# Sliding session length in hours (default 12).
SESSION_TTL_HOURS=
# Base URL of invite links (default: the first CORS origin).
DASHBOARD_URL=
# --- Cloud mode (names only) ---
# Credentials the restaurant's connector uses to publish into MediaMTX. Letters, digits and
# !$()*+.;<=>[]^_-,@#& only (MediaMTX rule). Generate: openssl rand -hex 24
# Empty = publishing into MediaMTX is disabled.
STREAM_PUBLISH_USER=
STREAM_PUBLISH_PASSWORD=
# Connector: base URL of the cloud MediaMTX (default rtsp://localhost:8554).
CLOUD_RTSP_URL=
# Camera id pushed by the connector and analysed by the `vision` service (default cam-01).
CAMERA_ID=
# Frames per second sent and analysed (default 5); upload width in px (default 640);
# upload bitrate in kbps (default 400).
CLOUD_FPS=
CLOUD_WIDTH=
CLOUD_BITRATE_KBPS=
