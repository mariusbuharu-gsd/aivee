# AiVee local env — NEVER commit. Copy structure lives in .env.example
# --- Claude (fill in yourself) ---
ANTHROPIC_API_KEY=
# --- Telegram (fill in yourself; chat id is discovered automatically) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: prepended to every Telegram message, e.g. [test]
TELEGRAM_PREFIX=
# --- Postgres ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=
# --- Mosquitto (one user per role, ACL in infra/mosquitto/acl) ---
MQTT_API_USER=
MQTT_API_PASSWORD=
MQTT_INGEST_USER=
MQTT_INGEST_PASSWORD=
MQTT_EDGE_USER=
MQTT_EDGE_PASSWORD=
# --- Web Push for the PWA (generated by `make vapid`; subject is a mailto: or https: contact) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# --- API / edge identity (names only; defaults SITE=demo, DEVICE=edge-01) ---
SITE=
DEVICE=
# --- Snapshots (names only) ---
# Host API and ingest share one dir. Default SNAPSHOT_DIR=data/snapshots (relative to the
# repo root); compose bind-mounts ./data/snapshots into ingest and api at /data/snapshots.
SNAPSHOT_DIR=
# Host uid/gid the ingest container runs as, so it can write ./data/snapshots (default 1000).
AIVEE_UID=
AIVEE_GID=
# --- Compose API image (names only) ---
# Empty = slim image without enrolment models; "--extra ml" = with them (CPU torch).
API_UV_EXTRAS=
# --- Accounts (names only) ---
# Demo users' password for `make seed` (generated into .env when empty).
DEMO_PASSWORD=
# Dashboard origins allowed with credentials, comma-separated
# (default http://localhost:5173,http://localhost:5174).
CORS_ORIGINS=
# true behind HTTPS: the session cookie gets `Secure`.
COOKIE_SECURE=
# Sliding session length in hours (default 12).
SESSION_TTL_HOURS=
# Base URL of invite links (default: the first CORS origin).
DASHBOARD_URL=
