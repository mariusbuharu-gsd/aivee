# Edge on site (customer PC or edge box). Copy to edge.env and fill in. Never commit edge.env:
# it holds the device credential and the camera passwords.
# --- AiVee cloud broker ---
MQTT_HOST=
MQTT_PORT=1883
# This device's identity and credential (one per device; the broker ACL limits it to its topics).
MQTT_EDGE_USER=
MQTT_EDGE_PASSWORD=
# Location id the device belongs to.
SITE=
# --- Cameras ---
# Nothing to set: add the cameras in the dashboard (Camere → Caută camere, password, Testează).
# The device runs the cameras the dashboard lists for it and follows changes without a restart.
#
# Dev overrides only (leave empty on a real box; when set they win over the dashboard):
#   CAMERAS=cam-01=rtsp://USER:PASS@192.168.1.21:554/stream2;cam-02=rtsp://USER:PASS@192.168.1.22:554/stream2
#   SOURCE=<one camera URL> with CAMERA_ID=<its id>; SOURCE wins over CAMERAS.
CAMERAS=
CAMERA_ID=
SOURCE=
# 0, 90, 180 or 270 degrees clockwise (every camera).
ROTATE=0
# Frames per second analysed per camera (default 10 on site).
TARGET_FPS=10
