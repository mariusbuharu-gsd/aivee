# Edge on site (customer PC or edge box). Copy to edge.env and fill in. Never commit edge.env.
# --- AiVee cloud broker ---
MQTT_HOST=
MQTT_PORT=1883
# This device's identity and credential (one per device; the broker ACL limits it to its topics).
MQTT_EDGE_USER=
MQTT_EDGE_PASSWORD=
# Location id the device belongs to.
SITE=
# --- Camera (also settable in the shell when starting compose) ---
CAMERA_ID=cam-01
# RTSP URL of the camera on the restaurant network, a phone MJPEG URL, or a video file.
SOURCE=
# 0, 90, 180 or 270 degrees clockwise.
ROTATE=0
# Frames per second analysed (default 10 on site).
TARGET_FPS=10
