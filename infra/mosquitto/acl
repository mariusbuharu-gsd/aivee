# API publishes rules/profiles and may read everything.
user aivee-api
topic readwrite aivee/#

# Ingest only reads.
user aivee-ingest
topic read aivee/#
topic read $share/ingest/aivee/#

# Edge devices: %u = MQTT username = device id. A device can only touch its own topics.
# The uploaded-clip runner (MQTT_UPLOAD_USER, e.g. upload-01) is one such device: its
# username starts with `upload-`, which ingest reads as "never notify staff".
pattern write aivee/+/%u/status
pattern write aivee/+/%u/events
pattern write aivee/+/%u/metrics
pattern write aivee/+/%u/suggestions
pattern write aivee/+/%u/snapshots/#
pattern write aivee/+/%u/detections
pattern read aivee/+/%u/rules
pattern read aivee/+/%u/profiles
pattern read aivee/+/%u/config
pattern read aivee/+/%u/commands
