{
  "$defs": {
    "CameraConfig": {
      "description": "What an edge device needs to know about one camera.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "description": "RTSP/HTTP URL or device index",
          "title": "Source",
          "type": "string"
        },
        "zones": {
          "items": {
            "$ref": "#/$defs/Zone"
          },
          "title": "Zones",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "source"
      ],
      "title": "CameraConfig",
      "type": "object"
    },
    "Zone": {
      "description": "A named area drawn on a camera image, e.g. a table or the entrance.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "tag": {
          "description": "Zone kind used by rules: \"table\", \"entrance\", \"staff\"…",
          "title": "Tag",
          "type": "string"
        },
        "polygon": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 3,
          "title": "Polygon",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "tag",
        "polygon"
      ],
      "title": "Zone",
      "type": "object"
    }
  },
  "description": "Retained payload on the device's `config` topic: cameras and their zones.",
  "properties": {
    "device": {
      "title": "Device",
      "type": "string"
    },
    "cameras": {
      "items": {
        "$ref": "#/$defs/CameraConfig"
      },
      "title": "Cameras",
      "type": "array"
    }
  },
  "required": [
    "device"
  ],
  "title": "DeviceConfig",
  "type": "object"
}
