{
  "$defs": {
    "ObjectChange": {
      "description": "What changed for an `object_gone` alert: the COCO classes that disappeared.",
      "properties": {
        "kind": {
          "const": "gone",
          "default": "gone",
          "title": "Kind",
          "type": "string"
        },
        "objects": {
          "description": "COCO class names that disappeared",
          "items": {
            "type": "string"
          },
          "title": "Objects",
          "type": "array"
        },
        "before_snapshot": {
          "default": false,
          "description": "The last frame with the object was sent on `snapshots/<event_id>-before`",
          "title": "Before Snapshot",
          "type": "boolean"
        }
      },
      "required": [
        "objects"
      ],
      "title": "ObjectChange",
      "type": "object"
    }
  },
  "description": "Published by the edge when a rule's situation starts or stops holding, and once in\nbetween (`arrived`) when a staff member has stayed in the zone for ARRIVE_S.",
  "properties": {
    "event_id": {
      "description": "UUID; idempotency key for ingest",
      "title": "Event Id",
      "type": "string"
    },
    "rule_id": {
      "title": "Rule Id",
      "type": "string"
    },
    "camera_id": {
      "title": "Camera Id",
      "type": "string"
    },
    "zone_id": {
      "title": "Zone Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "opened",
        "arrived",
        "closed"
      ],
      "title": "State",
      "type": "string"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "summary_ro": {
      "title": "Summary Ro",
      "type": "string"
    },
    "snapshot": {
      "default": false,
      "title": "Snapshot",
      "type": "boolean"
    },
    "object_change": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObjectChange"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set on `opened` events of an `object_gone` rule"
    }
  },
  "required": [
    "event_id",
    "rule_id",
    "camera_id",
    "zone_id",
    "state",
    "at",
    "summary_ro"
  ],
  "title": "AlertEvent",
  "type": "object"
}
